{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 /path/to/scripts/destructive-command-gate.py", "timeout": 5 },
          { "type": "command", "command": "python3 /path/to/scripts/prune-gate.py" },
          { "type": "command", "command": "python3 /path/to/scripts/push-gate.py" },
          { "type": "command", "command": "python3 /path/to/scripts/merge-gate.py" },
          { "type": "command", "command": "python3 /path/to/scripts/git-add-commit-gate.py" },
          { "type": "command", "command": "python3 /path/to/scripts/commit-secret-sweep.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "python3 /path/to/scripts/autogate_state.py --mark" }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "python3 /path/to/scripts/autogate_state.py --clear" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /path/to/scripts/stop-gate.py" }
        ]
      }
    ]
  }
}
